{
  "config": {
    "step": {
      "user": {
        "title": "Set up Maico KWL",
        "description": "Connection to the ventilation unit over Modbus TCP (firmware V1.1.1 or newer). The unit accepts a single Modbus TCP connection only.",
        "data": {
          "host": "Host",
          "port": "Port",
          "slave": "Modbus address (unit ID)"
        },
        "data_description": {
          "host": "IP address or host name of the ventilation unit.",
          "port": "Modbus TCP port, 502 by default.",
          "slave": "Modbus address set on the unit, 10 by default."
        }
      },
      "reconfigure": {
        "title": "Change connection",
        "data": {
          "host": "Host",
          "port": "Port",
          "slave": "Modbus address (unit ID)"
        },
        "data_description": {
          "host": "IP address or host name of the ventilation unit.",
          "port": "Modbus TCP port, 502 by default.",
          "slave": "Modbus address set on the unit, 10 by default."
        }
      }
    },
    "error": {
      "cannot_connect": "Could not connect to the unit. Check host, port and Modbus address, and that no other program holds the unit's only Modbus TCP connection.",
      "not_maico": "The device answers, but its values do not match a Maico KWL. Check the address.",
      "unknown": "Unexpected error, see the log."
    },
    "abort": {
      "already_configured": "This unit is already configured.",
      "reconfigure_successful": "The connection was changed."
    }
  },
